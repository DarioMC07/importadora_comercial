# Supabase (público, seguro de exponer al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo servidor. NUNCA exponer al cliente, al repositorio ni a logs.
# Se usa únicamente en scripts administrativos (seed de usuarios).
SUPABASE_SERVICE_ROLE_KEY=

# Configuración regional de la aplicación
NEXT_PUBLIC_APP_CURRENCY=BOB
NEXT_PUBLIC_APP_TIMEZONE=America/La_Paz
NEXT_PUBLIC_APP_LOCALE=es-BO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate limiting en memoria (desarrollo). En producción usar un store compartido (Upstash, etc.)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REQUESTS_PER_HOUR=10
